<overlays:ModuleOverlay x:Class="Vanilla_RTX_App.Modules.LUT.LUTManagerOverlay"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Vanilla_RTX_App.Modules.LUT"
                        xmlns:core="using:Vanilla_RTX_App.Core"
                        xmlns:overlays="using:Vanilla_RTX_App.Core.Overlays"
                        IsTextScaleFactorEnabled="False">

    <Grid>

        <!-- Loading Screen -->
        <Grid x:Name="LoadingPanel"
              Visibility="Visible"
              Background="Transparent">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="20">
                <ProgressRing IsActive="True"
                              Width="100"
                              Height="100"/>

                <!-- Shown together, and only while a manual pick is the thing being offered: the
                     explanation under the button reads as an instruction for whatever is on screen,
                     so it must never outlive the button it explains. -->
                <StackPanel x:Name="ManualSelectionPanel"
                            Visibility="Collapsed"
                            Spacing="20"
                            HorizontalAlignment="Center">
                    <Button x:Name="ManualSelectionButton"
                            HorizontalAlignment="Center"
                            Padding="20,12,20,12"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="ManualSelectionButton_Click">
                        <StackPanel Spacing="10">
                            <TextBlock Text="We couldn't auto-locate your game files using conventional tactics&#x0a;A system-wide scan is in progress, there is a high chance it will find your game given enough time."
                                       FontSize="14"
                                       TextAlignment="Center"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       IsTextScaleFactorEnabled="False" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ManualSelectionText"
                               Text="Taking far too long? Click above and manually navigate to the folder where the game is installed to, it should have a file called Minecraft.Windows.exe inside of it. You could do the same from the settings menu, but if you're still having trouble finding out where your game is installed to, join the Vanilla RTX Discord server and ask for help, or try to find out online."
                               FontSize="13"
                               Opacity="0.75"
                               FontWeight="Normal"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400"
                               IsTextScaleFactorEnabled="False" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Main UI - one flat content area. Nothing here scrolls. -->
        <Grid x:Name="MainPanel"
              Visibility="Collapsed">
            <!-- Content -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Button pair -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: No-usable-backup notice -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 2: Description text -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 3: Preset preview image -->
                    <RowDefinition Height="*" />
                    <!-- Row 4: More desc pains -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════
                     ROW 0 — Preset dropdown + Install button pair
                     ═══════════════════════════════════════════════ -->

                <Grid x:Name="ButtonRowGrid"
                      Grid.Row="0"
                      Height="50"
                      Margin="20,14,20,6"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Stretch"
                      Translation="0,0,32">
                    <Grid.Shadow>
                        <ThemeShadow />
                    </Grid.Shadow>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.15*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <DropDownButton x:Name="SelectPresetMenu"
                                    Grid.Column="0"
                                    Content="Loading..."
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    FontWeight="SemiBold"
                                    CornerRadius="4,0,0,4"
                                    BorderThickness="0"
                                    IsTextScaleFactorEnabled="False"
                                    ToolTipService.ToolTip="Select a LUT preset">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom" />
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button x:Name="InstallButton"
                            Grid.Column="2"
                            Content="Install"
                            Click="InstallButton_Click"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CornerRadius="0,6,6,0"
                            BorderThickness="0"
                            IsEnabled="False"
                            IsTextScaleFactorEnabled="False"
                            ToolTipService.ToolTip="Install the selected preset." />

                    <!-- Visual split — dark border on right edge of left button -->
                    <Grid Grid.Column="0"
                          HorizontalAlignment="Right"
                          Width="3"
                          Margin="0,0,-3,0"
                          IsHitTestVisible="False">
                        <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                        <Border BorderBrush="{ThemeResource FakeSplitButtonDarkBorderColor}"
                                BorderThickness="3,0,0,0" />
                    </Grid>

                    <!-- Visual split — bright border on left edge of right button -->
                    <Grid Grid.Column="2"
                          HorizontalAlignment="Left"
                          Width="3"
                          Margin="-3,0,0,0"
                          IsHitTestVisible="False">
                        <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                        <Border BorderBrush="{ThemeResource FakeSplitButtonBrightBorderColor}"
                                BorderThickness="3,0,0,0"
                                x:Name="LeftEdgeOfInstallButton"/>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════
                 ROW 1 — No usable Default backup

                 A static Pinned-TeletextCard lookalike, same as the shader mod manager's: same corner radius,
                 padding, translation, shadow and accent glyph as Core\TeletextCard.xaml, minus the
                 dismiss button, because there is nothing here for the user to dismiss. Filled
                 and shown by ApplyDefaultsNotice(), which also takes the dropdown and the
                 install button down - the card explains, the disabled controls enforce.
                   ═══════════════════════════════════════════════ -->
                <Border x:Name="DefaultsMissingCard"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Margin="20,12,20,0"
                        CornerRadius="6"
                        Padding="6"
                        Translation="0,0,32"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>

                    <Grid HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Margin="16,8,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7BA;"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="20"
                                  VerticalAlignment="Top"
                                  Margin="0,5,0,0"
                                  IsHitTestVisible="False"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                        <TextBlock x:Name="DefaultsMissingText"
                                   Grid.Column="1"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Margin="12,0,0,0"
                                   Opacity="0.95"
                                   VerticalAlignment="Center"
                                   IsTextScaleFactorEnabled="False" />
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════
                 ROW 2 — Online announcements
                   ═══════════════════════════════════════════════ -->
                <StackPanel x:Name="LutManagerInfoPanel"
                            Grid.Row="2"
                            Spacing="12"
                            Margin="20,12,20,8" />

                <!-- ═══════════════════════════════════════════════
                     ROW 3 — Preset preview image (crossfade vessels)
                     Bottom vessel: current/settled image
                     Top vessel:    incoming image, fades in over bottom
                     ═══════════════════════════════════════════════ -->
                <Grid Grid.Row="3"
                      Padding="0,12,0,0">

                    <Rectangle Fill="{StaticResource FakeSplitButtonBrightBorderColor}"
                               Height="6"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Top"
                               Canvas.ZIndex="996"
                               Opacity="1.0">
                        
                    </Rectangle>
                    <Rectangle Fill="{StaticResource FakeSplitButtonBrightBorderColor}"
                               Height="3"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Top"
                               Canvas.ZIndex="997"
                               Opacity="1.0">
                    </Rectangle>

                    <!-- Bottom vessel — holds the settled (current) image -->
                    <Image x:Name="PresetImageBottom"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="1" />

                    <!-- Top vessel — fades in the incoming image over the bottom -->
                    <Image x:Name="PresetImageTop"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0">
                        <Image.Transitions>
                            <TransitionCollection />
                        </Image.Transitions>
                    </Image>
                </Grid>


            </Grid>
        </Grid>

    </Grid>
</overlays:ModuleOverlay>
