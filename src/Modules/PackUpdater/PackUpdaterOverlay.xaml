<overlays:ModuleOverlay x:Class="Vanilla_RTX_App.Modules.PackUpdater.PackUpdaterOverlay"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:overlays="using:Vanilla_RTX_App.Core.Overlays"
                        IsTextScaleFactorEnabled="False">

    <Grid>
        <!-- Main Layout - one flat scrollable area. There is no titlebar or light-theme tint
             here any more: this is a ModuleOverlay, so MainWindow's own titlebar sits above it
             and MainWindow's tint covers it. -->
        <Grid>
            <!-- Scrollable Content Area -->
            <ScrollViewer x:Name="ContentScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12"
                            Margin="20, 12, 24, 12">

                    <!-- Main Pack Panels -->
                    <Grid x:Name="MainPanelsGrid"
                          MaxHeight="600">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Panel 1: Vanilla RTX Normals -->
                        <Border Grid.Column="0"
                                x:Name="NormalsPanel"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Translation="0,0,32"
                                MaxHeight="600">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Image Section -->
                                <Grid Grid.Row="0">
                                    <Border CornerRadius="8,8,0,0">
                                        <Image Source="ms-appx:///Assets/covers/normals.cover.png"
                                               Stretch="UniformToFill"
                                               IsHitTestVisible="False"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               MaxHeight="325"
                                               CacheMode="BitmapCache" />
                                    </Border>

                                    <!-- Overlay with title and description -->
                                    <Border x:Name="NormalsOverlay"
                                            CornerRadius="0,0,0,0"
                                            VerticalAlignment="Bottom"
                                            Opacity="0">
                                        <Border.Background>
                                            <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                                          TintOpacity="0.0"
                                                          TintLuminosityOpacity="0.64"
                                                          FallbackColor="{ThemeResource AcrylicFallbackColor}" />
                                        </Border.Background>

                                        <!-- The whole overlay is the link, not just the title: it is only on screen while a
                                             pointer sits over the cover, so a target one line of text tall is one most people
                                             never find. The padding is the button's so the inset is clickable too. -->
                                        <HyperlinkButton NavigateUri="https://www.curseforge.com/minecraft-bedrock/texture-packs/truly-vanilla-rtx"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         HorizontalContentAlignment="Stretch"
                                                         VerticalContentAlignment="Center"
                                                         Padding="16,10,16,12"
                                                         CornerRadius="0"
                                                         BorderThickness="0"
                                                         ToolTipService.ToolTip="https://www.curseforge.com/minecraft-bedrock/texture-packs/truly-vanilla-rtx"
                                                         IsTextScaleFactorEnabled="False">
                                            <StackPanel Spacing="4">
                                                <!-- Pack Name -->
                                                <TextBlock Text="Vanilla RTX Normals"
                                                           FontSize="18"
                                                           Foreground="{ThemeResource OverlayTextBrush}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           IsTextScaleFactorEnabled="False" />

                                                <!-- Description -->
                                                <TextBlock Text="Vanilla RTX with handcrafted 16x normal maps for all blocks!"
                                                           Foreground="{ThemeResource OverlayTextBrush}"
                                                           FontSize="13"
                                                           Opacity="0.9"
                                                           TextWrapping="Wrap"
                                                           IsTextScaleFactorEnabled="False" />
                                            </StackPanel>
                                        </HyperlinkButton>
                                    </Border>
                                </Grid>

                                <!-- Info Section -->
                                <StackPanel Grid.Row="1"
                                            Padding="16"
                                            Spacing="4">
                                    <!-- Installed Version -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <TextBlock Text="Installed:"
                                                   FontSize="13"
                                                   Opacity="0.75"
                                                   IsTextScaleFactorEnabled="False" />
                                        <TextBlock x:Name="VanillaRTXNormals_InstalledVersion"
                                                   Text="Not installed"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   IsTextScaleFactorEnabled="False" />
                                    </StackPanel>

                                    <!-- Available Version -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <TextBlock Text="Available:"
                                                   FontSize="13"
                                                   Opacity="0.75"
                                                   IsTextScaleFactorEnabled="False" />
                                        <ProgressRing x:Name="VanillaRTXNormals_AvailableLoading"
                                                      Width="16"
                                                      Height="16"
                                                      IsActive="True"
                                                      Visibility="Visible" />
                                        <TextBlock x:Name="VanillaRTXNormals_AvailableVersion"
                                                   Text="Checking..."
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   IsTextScaleFactorEnabled="False"
                                                   Visibility="Collapsed" />
                                    </StackPanel>

                                    <!-- Controls Row -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Enhancement Toggle -->
                                        <ToggleSwitch x:Name="VanillaRTXNormals_EnhancementsToggle"
                                                      Grid.Column="0"
                                                      Header="Enhancements"
                                                      IsOn="True"
                                                      ToolTipService.ToolTip="Enables deployment of enhancements for this resource pack. This fixes numerous rendering errors &amp; incompatibilities of vanilla features and resources with ray tracing and enhances various other resources such as particles for ray tracing.
                                                       &#x0a;&#x0a;Enhancements are generally classified as slightly non-vanilla changes and are developed separately for Vanilla RTX resource packs, the files are then merged into the base pack for public releases or during installation if this toggle is left On.
                                                       &#x0a;&#x0a;For more details, check Vanilla RTX download pages - It is generally recommended that you keep this enabled, unless it causes issues with another add-on or resource pack you're using or you have a specific reason to."
                                                      IsTextScaleFactorEnabled="False" />

                                        <!-- Install Button -->
                                        <Grid Grid.Column="2"
                                              MinWidth="120"
                                              MinHeight="60"
                                              CornerRadius="6"
                                              Translation="0,0,12">
                                            <Button x:Name="VanillaRTXNormals_InstallButton"
                                                    Content="Install"
                                                    FontWeight="SemiBold"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    IsEnabled="False"
                                                    IsTextScaleFactorEnabled="False" />
                                            <Grid.Shadow>
                                                <ThemeShadow />
                                            </Grid.Shadow>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Panel 2: Vanilla RTX -->
                        <Border Grid.Column="2"
                                x:Name="VanillaPanel"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Translation="0,0,32"
                                MaxHeight="600">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Image Section -->
                                <Grid Grid.Row="0">
                                    <Border CornerRadius="8,8,0,0">
                                        <Image Source="ms-appx:///Assets/covers/regular.cover.png"
                                               Stretch="UniformToFill"
                                               IsHitTestVisible="False"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               MaxHeight="325"
                                               CacheMode="BitmapCache" />
                                    </Border>

                                    <!-- Overlay with title and description -->
                                    <Border x:Name="VanillaOverlay"
                                            CornerRadius="0,0,0,0"
                                            VerticalAlignment="Bottom"
                                            Opacity="0">
                                        <Border.Background>
                                            <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                                          TintOpacity="0.0"
                                                          TintLuminosityOpacity="0.64"
                                                          FallbackColor="{ThemeResource AcrylicFallbackColor}" />
                                        </Border.Background>

                                        <!-- The whole overlay is the link, not just the title: it is only on screen while a
                                             pointer sits over the cover, so a target one line of text tall is one most people
                                             never find. The padding is the button's so the inset is clickable too. -->
                                        <HyperlinkButton NavigateUri="https://www.curseforge.com/minecraft-bedrock/texture-packs/vanilla-rtx"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         HorizontalContentAlignment="Stretch"
                                                         VerticalContentAlignment="Center"
                                                         Padding="16,10,16,12"
                                                         CornerRadius="0"
                                                         BorderThickness="0"
                                                         ToolTipService.ToolTip="https://www.curseforge.com/minecraft-bedrock/texture-packs/vanilla-rtx"
                                                         IsTextScaleFactorEnabled="False">
                                            <StackPanel Spacing="4">
                                                <!-- Pack Name -->
                                                <TextBlock Text="Vanilla RTX"
                                                           FontSize="18"
                                                           Foreground="{ThemeResource OverlayTextBrush}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           IsTextScaleFactorEnabled="False" />

                                                <!-- Description -->
                                                <TextBlock Text="The default ray-traced Minecraft graphics, everything is covered!"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource OverlayTextBrush}"
                                                           Opacity="0.9"
                                                           TextWrapping="Wrap"
                                                           IsTextScaleFactorEnabled="False" />
                                            </StackPanel>
                                        </HyperlinkButton>
                                    </Border>
                                </Grid>

                                <!-- Info Section -->
                                <StackPanel Grid.Row="1"
                                            Padding="16"
                                            Spacing="4">
                                    <!-- Installed Version -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <TextBlock Text="Installed:"
                                                   FontSize="13"
                                                   Opacity="0.75"
                                                   IsTextScaleFactorEnabled="False" />
                                        <TextBlock x:Name="VanillaRTX_InstalledVersion"
                                                   Text="Not installed"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   IsTextScaleFactorEnabled="False" />
                                    </StackPanel>

                                    <!-- Available Version -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <TextBlock Text="Available:"
                                                   FontSize="13"
                                                   Opacity="0.75"
                                                   IsTextScaleFactorEnabled="False" />
                                        <ProgressRing x:Name="VanillaRTX_AvailableLoading"
                                                      Width="16"
                                                      Height="16"
                                                      IsActive="True"
                                                      Visibility="Visible" />
                                        <TextBlock x:Name="VanillaRTX_AvailableVersion"
                                                   Text="Checking..."
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   IsTextScaleFactorEnabled="False"
                                                   Visibility="Collapsed" />
                                    </StackPanel>

                                    <!-- Controls Row -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Enhancement Toggle -->
                                        <ToggleSwitch x:Name="VanillaRTX_EnhancementsToggle"
                                                      Grid.Column="0"
                                                      Header="Enhancements"
                                                      IsOn="True"
                                                      ToolTipService.ToolTip="Enables deployment of enhancements for this resource pack. This fixes numerous rendering errors &amp; incompatibilities of vanilla features and resources with ray tracing and enhances various other resources such as particles for ray tracing.
                                                       &#x0a;&#x0a;Enhancements are generally classified as slightly non-vanilla changes and are developed separately for Vanilla RTX resource packs, the files are then merged into the base pack for public releases or during installation if this toggle is left On.
                                                       &#x0a;&#x0a;For more details, check Vanilla RTX download pages - It is generally recommended that you keep this enabled, unless it causes issues with another add-on or resource pack you're using or you have a specific reason to."
                                                      IsTextScaleFactorEnabled="False" />

                                        <!-- Install Button -->
                                        <Grid Grid.Column="2"
                                              MinWidth="120"
                                              MinHeight="60"
                                              CornerRadius="6"
                                              Translation="0,0,12">
                                            <Button x:Name="VanillaRTX_InstallButton"
                                                    Content="Install"
                                                    FontWeight="SemiBold"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    IsEnabled="False"
                                                    IsTextScaleFactorEnabled="False" />
                                            <Grid.Shadow>
                                                <ThemeShadow />
                                            </Grid.Shadow>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Panel 3: Vanilla RTX Opus -->
                        <Border Grid.Column="4"
                                x:Name="OpusPanel"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Translation="0,0,32"
                                MaxHeight="600">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Image Section -->
                                <Grid Grid.Row="0">
                                    <Border CornerRadius="8,8,0,0">
                                        <Image Source="ms-appx:///Assets/covers/opus.cover.png"
                                               Stretch="UniformToFill"
                                               IsHitTestVisible="False"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               MaxHeight="325"
                                               CacheMode="BitmapCache" />
                                    </Border>

                                    <!-- Overlay with title and description -->
                                    <Border x:Name="OpusOverlay"
                                            CornerRadius="0,0,0,0"
                                            VerticalAlignment="Bottom"
                                            Opacity="0">
                                        <Border.Background>
                                            <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                                          TintOpacity="0.0"
                                                          TintLuminosityOpacity="0.64"
                                                          FallbackColor="{ThemeResource AcrylicFallbackColor}" />
                                        </Border.Background>

                                        <!-- The whole overlay is the link -->
                                        <HyperlinkButton NavigateUri="https://www.curseforge.com/minecraft-bedrock/texture-packs/vanilla-rtx-opus"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         HorizontalContentAlignment="Stretch"
                                                         VerticalContentAlignment="Center"
                                                         Padding="16,10,16,12"
                                                         CornerRadius="0"
                                                         BorderThickness="0"
                                                         ToolTipService.ToolTip="https://www.curseforge.com/minecraft-bedrock/texture-packs/vanilla-rtx-opus"
                                                         IsTextScaleFactorEnabled="False">
                                            <StackPanel Spacing="4">
                                                <!-- Pack Name -->
                                                <TextBlock Text="Vanilla RTX Opus"
                                                           FontSize="18"
                                                           Foreground="{ThemeResource OverlayTextBrush}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           IsTextScaleFactorEnabled="False" />

                                                <!-- Description -->
                                                <TextBlock Text="The composition of both Vanilla RTX and Vanilla RTX Normals!"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource OverlayTextBrush}"
                                                           Opacity="0.9"
                                                           TextWrapping="Wrap"
                                                           IsTextScaleFactorEnabled="False" />
                                            </StackPanel>
                                        </HyperlinkButton>
                                    </Border>
                                </Grid>

                                <!-- Info Section -->
                                <StackPanel Grid.Row="1"
                                            Padding="16"
                                            Spacing="4">
                                    <!-- Installed Version -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <TextBlock Text="Installed:"
                                                   FontSize="13"
                                                   Opacity="0.75"
                                                   IsTextScaleFactorEnabled="False" />
                                        <TextBlock x:Name="VanillaRTXOpus_InstalledVersion"
                                                   Text="Not installed"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   IsTextScaleFactorEnabled="False" />
                                    </StackPanel>

                                    <!-- Available Version -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <TextBlock Text="Available:"
                                                   FontSize="13"
                                                   Opacity="0.75"
                                                   IsTextScaleFactorEnabled="False" />
                                        <ProgressRing x:Name="VanillaRTXOpus_AvailableLoading"
                                                      Width="16"
                                                      Height="16"
                                                      IsActive="True"
                                                      Visibility="Visible" />
                                        <TextBlock x:Name="VanillaRTXOpus_AvailableVersion"
                                                   Text="Checking..."
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   IsTextScaleFactorEnabled="False"
                                                   Visibility="Collapsed" />
                                    </StackPanel>

                                    <!-- Controls Row -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Enhancement Toggle -->
                                        <ToggleSwitch x:Name="VanillaRTXOpus_EnhancementsToggle"
                                                      Grid.Column="0"
                                                      Header="Enhancements"
                                                      IsOn="True"
                                                      ToolTipService.ToolTip="Enables deployment of enhancements for this resource pack. This fixes numerous rendering errors &amp; incompatibilities of vanilla features and resources with ray tracing and enhances various other resources such as particles for ray tracing.
                                                       &#x0a;&#x0a;Enhancements are generally classified as slightly non-vanilla changes and are developed separately for Vanilla RTX resource packs, the files are then merged into the base pack for public releases or during installation if this toggle is left On.
                                                       &#x0a;&#x0a;For more details, check Vanilla RTX download pages - It is generally recommended that you keep this enabled, unless it causes issues with another add-on or resource pack you're using or you have a specific reason to."
                                                      IsTextScaleFactorEnabled="False" />

                                        <!-- Install Button -->
                                        <Grid Grid.Column="2"
                                              MinWidth="120"
                                              MinHeight="60"
                                              CornerRadius="6"
                                              Translation="0,0,12">
                                            <Button x:Name="VanillaRTXOpus_InstallButton"
                                                    Content="Install"
                                                    FontWeight="SemiBold"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    IsEnabled="False"
                                                    IsTextScaleFactorEnabled="False" />
                                            <Grid.Shadow>
                                                <ThemeShadow />
                                            </Grid.Shadow>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SPECIAL CHRISTMAS PANEL -->
                    <Border x:Name="SpecialOccasionPanel"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Translation="0,0,32"
                            MaxHeight="325"
                            Visibility="Collapsed">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Description section: 1 panel width -->
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="12" />
                                <!-- Image section: 2 panels + 1 gap width -->
                                <ColumnDefinition Width="2.1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Description Section -->
                            <StackPanel Grid.Column="0"
                                        Padding="16"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Merry Christmas!"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           IsTextScaleFactorEnabled="False" />
                                <TextBlock Text="Get in the holiday spirit and jolly up Vanilla RTX with this special seasonal extension! Transform the world into a winter wonderland with frost-covered blocks, a freezing-cold Nether plus lots of other festive changes! Ho, ho, ho!
                                           — Cubeir Claus"
                                           FontSize="13"
                                           Opacity="0.9"
                                           TextWrapping="Wrap"
                                           IsTextScaleFactorEnabled="False" />
                                <!-- Download Button -->
                                <HyperlinkButton Content="Get the Extension"
                                                 FontSize="18"
                                                 FontWeight="SemiBold"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,8,0,0"
                                                 NavigateUri="http://mcpedl.com/vanilla-rtx-everwinter"
                                                 IsTextScaleFactorEnabled="False" />
                            </StackPanel>

                            <!-- Image Section with Overlay -->
                            <Grid Grid.Column="2">
                                <Border CornerRadius="0,8,8,0">
                                    <Image Source="ms-appx:///Assets/covers/everwinter.cover.png"
                                           Stretch="UniformToFill"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           CacheMode="BitmapCache" />
                                </Border>
                                <!-- Overlay -->
                                <Border x:Name="SpecialOccasionOverlay"
                                        CornerRadius="0"
                                        VerticalAlignment="Center"
                                        Opacity="0">
                                    <Border.Background>
                                        <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                                      TintOpacity="0.0"
                                                      TintLuminosityOpacity="0.64"
                                                      FallbackColor="{ThemeResource AcrylicFallbackColor}" />
                                    </Border.Background>
                                    <!-- The whole overlay is the link -->
                                    <HyperlinkButton NavigateUri="http://mcpedl.com/vanilla-rtx-everwinter"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     HorizontalContentAlignment="Stretch"
                                                     VerticalContentAlignment="Center"
                                                     Padding="16,10,16,12"
                                                     CornerRadius="0"
                                                     BorderThickness="0"
                                                     ToolTipService.ToolTip="http://mcpedl.com/vanilla-rtx-everwinter"
                                                     IsTextScaleFactorEnabled="False">
                                        <StackPanel Spacing="4">
                                            <!-- Pack Name -->
                                            <TextBlock Text="Vanilla RTX: Everwinter Extension"
                                                       FontSize="20"
                                                       Foreground="{ThemeResource OverlayTextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       IsTextScaleFactorEnabled="False" />
                                            <TextBlock Text="An extension of the Vanilla RTX resource pack, everything is covered in frost! Featuring unyielding cold!"
                                                       FontSize="14"
                                                       Foreground="{ThemeResource OverlayTextBrush}"
                                                       Opacity="0.9"
                                                       TextWrapping="Wrap"
                                                       IsTextScaleFactorEnabled="False" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ═══════════════════════════════════════════════
                         Online announcements (PackUpdateInfo)
                          ═══════════════════════════════════════════════ -->
                    <StackPanel x:Name="PackUpdateInfoPanel"
                                Spacing="12"
                                Margin="0,0,0,0" />

                    <!-- Secondary Packs Section -->
                    <Grid MaxHeight="325">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Secondary Pack 1: Vanilla RTX Add-Ons -->
                        <Border Grid.Column="0"
                                x:Name="AddOnsPanel"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Translation="0,0,32">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>

                            <Grid>
                                <Border CornerRadius="8">
                                    <Image Source="ms-appx:///Assets/covers/addons.cover.png"
                                           Stretch="UniformToFill"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           MaxHeight="325"
                                           CacheMode="BitmapCache" />
                                </Border>

                                <!-- Overlay with title and description -->
                                <Border x:Name="AddOnsOverlay"
                                        CornerRadius="0"
                                        VerticalAlignment="Center"
                                        Opacity="0">
                                    <Border.Background>
                                        <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                                      TintOpacity="0.0"
                                                      TintLuminosityOpacity="0.64"
                                                      FallbackColor="{ThemeResource AcrylicFallbackColor}" />
                                    </Border.Background>

                                    <!-- The whole overlay is the link -->
                                    <HyperlinkButton NavigateUri="https://curseforge.com/minecraft-bedrock/texture-packs/vanilla-rtx-add-ons"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     HorizontalContentAlignment="Stretch"
                                                     VerticalContentAlignment="Center"
                                                     Padding="16,10,16,12"
                                                     CornerRadius="0"
                                                     BorderThickness="0"
                                                     ToolTipService.ToolTip="https://curseforge.com/minecraft-bedrock/texture-packs/vanilla-rtx-add-ons"
                                                     IsTextScaleFactorEnabled="False">
                                        <StackPanel Spacing="4">
                                            <!-- Pack Name -->
                                            <TextBlock Text="Vanilla RTX Add-Ons"
                                                       FontSize="18"
                                                       Foreground="{ThemeResource OverlayTextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       IsTextScaleFactorEnabled="False" />

                                            <TextBlock Text="A series of smaller packages that give certain blocks more interesting properties with ray tracing!"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource OverlayTextBrush}"
                                                       Opacity="0.9"
                                                       TextWrapping="Wrap"
                                                       IsTextScaleFactorEnabled="False" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Secondary Pack 2: Chemistry RTX -->
                        <Border Grid.Column="2"
                                x:Name="ChemistryPanel"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Translation="0,0,32">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>

                            <Grid>
                                <Border CornerRadius="8">
                                    <Image Source="ms-appx:///Assets/covers/education.cover.png"
                                           Stretch="UniformToFill"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           MaxHeight="325"
                                           CacheMode="BitmapCache" />
                                </Border>

                                <!-- Overlay with title and description -->
                                <Border x:Name="ChemistryOverlay"
                                        CornerRadius="0"
                                        VerticalAlignment="Center"
                                        Opacity="0">
                                    <Border.Background>
                                        <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                                      TintOpacity="0.0"
                                                      TintLuminosityOpacity="0.64"
                                                      FallbackColor="{ThemeResource AcrylicFallbackColor}" />
                                    </Border.Background>

                                    <!-- The whole overlay is the link, not just the title: it is only on screen while a
                                         pointer sits over the cover, so a target one line of text tall is one most people
                                         never find. The padding is the button's so the inset is clickable too. -->
                                    <HyperlinkButton NavigateUri="https://www.curseforge.com/minecraft-bedrock/texture-packs/chemistry-rtx"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     HorizontalContentAlignment="Stretch"
                                                     VerticalContentAlignment="Center"
                                                     Padding="16,10,16,12"
                                                     CornerRadius="0"
                                                     BorderThickness="0"
                                                     ToolTipService.ToolTip="https://www.curseforge.com/minecraft-bedrock/texture-packs/chemistry-rtx"
                                                     IsTextScaleFactorEnabled="False">
                                        <StackPanel Spacing="4">
                                            <!-- Pack Name -->
                                            <TextBlock Text="Chemistry RTX Extensions"
                                                       FontSize="18"
                                                       Foreground="{ThemeResource OverlayTextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       IsTextScaleFactorEnabled="False" />

                                            <TextBlock Text="Optional Vanilla RTX extensions to extend ray tracing support to Education Edition content!"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource OverlayTextBrush}"
                                                       Opacity="0.9"
                                                       TextWrapping="Wrap"
                                                       IsTextScaleFactorEnabled="False" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Secondary Pack 3: Creative RTX -->
                        <Border Grid.Column="4"
                                x:Name="CreativePanel"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Translation="0,0,32">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>

                            <Grid>
                                <Border CornerRadius="8">
                                    <Image Source="ms-appx:///Assets/covers/creative.cover.png"
                                           Stretch="UniformToFill"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           MaxHeight="325"
                                           CacheMode="BitmapCache" />
                                </Border>

                                <!-- Overlay with title and description -->
                                <Border x:Name="CreativeOverlay"
                                        CornerRadius="0"
                                        VerticalAlignment="Center"
                                        Opacity="0">
                                    <Border.Background>
                                        <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                                                      TintOpacity="0.0"
                                                      TintLuminosityOpacity="0.64"
                                                      FallbackColor="{ThemeResource AcrylicFallbackColor}" />
                                    </Border.Background>

                                    <!-- The whole overlay is the link, not just the title: it is only on screen while a
                                         pointer sits over the cover, so a target one line of text tall is one most people
                                         never find. The padding is the button's so the inset is clickable too. -->
                                    <HyperlinkButton NavigateUri="https://www.curseforge.com/minecraft-bedrock/texture-packs/creative-rtx"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     HorizontalContentAlignment="Stretch"
                                                     VerticalContentAlignment="Center"
                                                     Padding="16,10,16,12"
                                                     CornerRadius="0"
                                                     BorderThickness="0"
                                                     ToolTipService.ToolTip="https://www.curseforge.com/minecraft-bedrock/texture-packs/creative-rtx"
                                                     IsTextScaleFactorEnabled="False">
                                        <StackPanel Spacing="4">
                                            <!-- Pack Name -->
                                            <TextBlock Text="Creative RTX Extension"
                                                       FontSize="18"
                                                       Foreground="{ThemeResource OverlayTextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       IsTextScaleFactorEnabled="False" />

                                            <TextBlock Text="Replaces Element block textures with high definition, exotic materials for creative builds with RTX!"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource OverlayTextBrush}"
                                                       Opacity="0.9"
                                                       TextWrapping="Wrap"
                                                       IsTextScaleFactorEnabled="False" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════
                         Online announcements (PackUpdateExtraInfo)
                          ═══════════════════════════════════════════════ -->
                    <StackPanel x:Name="PackUpdateExtraInfoPanel"
                                Spacing="12"
                                Margin="0,0,0,4" />

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- Handed to MainWindow's titlebar while this module is open - see ModuleOverlay. No
             size or alignment here: placement belongs to the control that hosts it. -->
        <Border x:Name="TitleBarActions">
            <Grid Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Changelog Button -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Column 1: Vertical Separator Line -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Column 2: Refresh Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Changelog Button -->
                <Button x:Name="ChangelogButton"
                        Grid.Column="0"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Content="&#xE81C;"
                        FontSize="14"
                        Width="40"
                        Height="35"
                        CornerRadius="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="ChangelogButton_Click"
                        IsTextScaleFactorEnabled="False"
                        ToolTipService.ToolTip="View Vanilla RTX changelog history, including the most recent release." />

                <!-- Separator -->
                <Border Grid.Column="1"
                        Width="1"
                        Margin="2,6,2,6"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Refresh Button -->
                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="40"
                        Height="35"
                        CornerRadius="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="RefreshButton_Click"
                        IsTextScaleFactorEnabled="False"
                        ToolTipService.ToolTip="Checks again: rescans the packs you have installed and asks the Vanilla RTX repository what the latest versions are.
                        &#x0a;&#x0a;The app already does this on its own, so use it when a release has just dropped and you would rather not wait. While it shows a countdown, the versions on screen were just fetched.">
                    <Grid>
                        <FontIcon x:Name="RefreshIcon"
                                  Glyph="&#xE72C;"
                                  FontSize="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsTextScaleFactorEnabled="False" />
                        <TextBlock x:Name="RefreshCountdownText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   IsTextScaleFactorEnabled="False" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

    </Grid>
</overlays:ModuleOverlay>
