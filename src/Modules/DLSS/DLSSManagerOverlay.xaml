<overlays:ModuleOverlay x:Class="Vanilla_RTX_App.Modules.DLSS.DLSSManagerOverlay"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Vanilla_RTX_App.Modules.DLSS"
                        xmlns:core="using:Vanilla_RTX_App.Core.Overlays"
                        xmlns:overlays="using:Vanilla_RTX_App.Core.Overlays"
                        IsTextScaleFactorEnabled="False">


    <Grid>

        <!-- Loading Screen -->
        <Grid x:Name="LoadingPanel"
              Visibility="Visible"
              Background="Transparent">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="20">
                <ProgressRing IsActive="True"
                              Width="100"
                              Height="100" />

                <!-- Shown together, and only while a manual pick is the thing being offered: the
                     explanation under the button reads as an instruction for whatever is on screen,
                     so it must never outlive the button it explains. -->
                <StackPanel x:Name="ManualSelectionPanel"
                            Visibility="Collapsed"
                            Spacing="20"
                            HorizontalAlignment="Center">
                    <Button x:Name="ManualSelectionButton"
                            HorizontalAlignment="Center"
                            Padding="20,12,20,12"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="ManualSelectionButton_Click">
                        <StackPanel Spacing="10">
                            <TextBlock Text="We couldn't auto-locate your game files using conventional tactics&#x0a;A system-wide scan is in progress, there is a high chance it will find your game given enough time."
                                       FontSize="14"
                                       TextAlignment="Center"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       IsTextScaleFactorEnabled="False" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ManualSelectionText"
                               Text="Taking far too long? Click above and manually navigate to the folder where the game is installed to, it should have a file called Minecraft.Windows.exe inside of it. You could do the same from the settings menu, but if you're still having trouble finding out where your game is installed to, join the Vanilla RTX Discord server and ask for help, or try to find out online."
                               FontSize="13"
                               Opacity="0.75"
                               FontWeight="Normal"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400"
                               IsTextScaleFactorEnabled="False" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- DLL Selection UI - one flat [scrollable, fixed-bar] split. -->
        <Grid x:Name="DllSelectionPanel"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <!-- DLL list (scrollable) -->
                <RowDefinition Height="*" />
                <!-- Add DLSS files (fixed) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="ShadowReceiverGrid"
                  Grid.Row="0" />

            <ScrollViewer Grid.Row="0"
                          IsTextScaleFactorEnabled="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="DLSSInfoPanel"
                                Spacing="10"
                                Margin="20,12,24,0" />

                    <!-- NVIDIA driver settings: only on a machine NVAPI answers on. The rows are
                         built from NvidiaDriverSettings.All - see BuildDriverSettingRows. -->
                    <Border x:Name="DriverSettingsCard"
                            Style="{StaticResource ThemedCardStyle}"
                            Visibility="Collapsed"
                            Margin="20,12,24,0"
                            Padding="16,12,16,16"
                            CornerRadius="8"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F4;"
                                          FontSize="18"
                                          VerticalAlignment="Center"
                                          IsTextScaleFactorEnabled="False" />
                                <TextBlock Grid.Column="1"
                                           Text="NVIDIA driver settings"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           IsTextScaleFactorEnabled="False" />
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <ProgressRing x:Name="DriverSettingsBusy"
                                                  Width="16"
                                                  Height="16"
                                                  IsActive="False"
                                                  Visibility="Collapsed" />
                                    <TextBlock x:Name="DriverSettingsStatus"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="360"
                                               Style="{StaticResource ThemedSecondaryTextStyle}"
                                               IsTextScaleFactorEnabled="False" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DriverSettingsNote"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource ThemedSecondaryTextStyle}"
                                       IsTextScaleFactorEnabled="False" />
                            <Grid x:Name="DriverSettingsRows"
                                  ColumnSpacing="12"
                                  Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="DllListContainer"
                                Spacing="12"
                                Margin="20,12,24,0"
                                Padding="0,0,0,12" />

                    <!-- Empty State: in the flow rather than over it, so the driver card and the
                         NVIDIA list stay readable when nothing is cached yet. -->
                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Margin="20,24,24,24"
                                Spacing="12">
                        <FontIcon Glyph="&#xF158;"
                                  FontSize="48"
                                  IsTextScaleFactorEnabled="False"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="EmptyStateText"
                                   Text="No DLSS versions cached"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   IsTextScaleFactorEnabled="False"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Builds from NVIDIA's own update server that aren't in the cache yet. The
                         secondary source, so lighter rows under a divider - see the manager's
                         region on the server for why it can only ever be secondary. -->
                    <StackPanel x:Name="NvidiaSection"
                                Visibility="Collapsed"
                                Margin="20,0,24,16"
                                Spacing="8">
                        <Grid ColumnSpacing="14"
                              Margin="8,4,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ThemedDividerRuleStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="More versions from NVIDIA"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource ThemedSecondaryTextStyle}"
                                       IsTextScaleFactorEnabled="False" />
                            <Border Grid.Column="2"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ThemedDividerRuleStyle}" />
                        </Grid>
                        <StackPanel x:Name="NvidiaStatusPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <ProgressRing x:Name="NvidiaLoading"
                                          Width="16"
                                          Height="16"
                                          IsActive="True" />
                            <TextBlock x:Name="NvidiaStatusText"
                                       Text="Checking NVIDIA's update server..."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource ThemedSecondaryTextStyle}"
                                       IsTextScaleFactorEnabled="False" />
                        </StackPanel>
                        <StackPanel x:Name="NvidiaListContainer"
                                    Spacing="6" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════
                Add DLSS files
            ═══════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Margin="0"
                    CornerRadius="0"
                    BorderThickness="0"
                    Translation="0,1,512"
                    Background="Transparent">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <Grid MinHeight="96"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <!-- Add DLSS files -->
                        <ColumnDefinition Width="2*" />
                        <!-- Gap 6 px -->
                        <ColumnDefinition Width="6" />
                        <!-- Download DLSS files -->
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── ADD DLSS FILES ─────────────────────── -->
                    <Button x:Name="AddDllButton"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="20,0,20,0"
                            CornerRadius="0"
                            BorderThickness="0"
                            IsTextScaleFactorEnabled="False"
                            AllowDrop="True"
                            Click="AddDllButton_Click"
                            DragOver="AddDllButton_DragOver"
                            DragEnter="AddDllButton_DragEnter"
                            DragLeave="AddDllButton_DragLeave"
                            Drop="AddDllButton_Drop"
                            ToolTipService.ToolTip="Drag and drop or browse for a DLSS DLL file to add (.dll or .zip with the dlls)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="96"
                                    Height="96"
                                    CornerRadius="5,0,0,5"
                                    Background="Transparent">
                                <FontIcon Glyph="&#xE710;"
                                          FontSize="44"
                                          FontWeight="ExtraLight"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsTextScaleFactorEnabled="False" />
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Add DLSS files manually"
                                           FontWeight="SemiBold"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           IsTextScaleFactorEnabled="False" />
                                <TextBlock Text="Drag and drop or browse for a DLSS DLL file to add (.dll or .zip with the dlls)"
                                           FontSize="12"
                                           Opacity="0.75"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           IsTextScaleFactorEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- ── DOWNLOAD DLSS FILES ────────────────── -->
                    <!-- Solid backdrop behind the hyperlink button: HyperlinkButton's own
                         background is too translucent against the window now that it's
                         not sitting on top of the Add button anymore. This mimics a
                         regular button's background while leaving hover/pressed states
                         to the hyperlink itself. -->
                    <Rectangle Grid.Column="2"
                               Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                               IsHitTestVisible="False" />

                    <!-- Both the label and the tooltip name the address this actually opens,
                         which is a setting - see DLSSManagerOverlay's constructor. -->
                    <HyperlinkButton x:Name="DownloadDllsButton"
                                     Grid.Column="2"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Padding="0"
                                     CornerRadius="0"
                                     BorderThickness="0"
                                     IsTextScaleFactorEnabled="False"
                                     Click="DownloadDllsButton_Click">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="8">
                                <FontIcon Glyph="&#xE71B;"
                                          FontSize="20"
                                          Margin="0,3,0,0"
                                          VerticalAlignment="Center"
                                          IsTextScaleFactorEnabled="False" />
                                <TextBlock Text="Download DLSS files"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsTextScaleFactorEnabled="False" />
                            </StackPanel>
                            <TextBlock x:Name="DownloadDllsTargetText"
                                       FontSize="11"
                                       Opacity="0.67"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       IsTextScaleFactorEnabled="False" />
                        </StackPanel>
                    </HyperlinkButton>

                    <!-- ── BEVELLED SPLIT SEAM ──────────────────── -->
                    <Grid Grid.Column="0"
                          HorizontalAlignment="Right"
                          Width="3"
                          Margin="0,0,-3,0"
                          IsHitTestVisible="False">
                        <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                        <Border BorderBrush="{ThemeResource FakeSplitButtonDarkBorderColor}"
                                BorderThickness="3,0,0,0" />
                    </Grid>

                    <Grid Grid.Column="2"
                          HorizontalAlignment="Left"
                          Width="3"
                          Margin="-3,0,0,0"
                          IsHitTestVisible="False">
                        <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                        <Border BorderBrush="{ThemeResource FakeSplitButtonBrightBorderColor}"
                                BorderThickness="3,0,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>


        <core:WebImportOverlay x:Name="WebImportOverlay" />
    </Grid>
</overlays:ModuleOverlay>
