<overlays:ModuleOverlay x:Class="Vanilla_RTX_App.Modules.ShaderMods.ShaderModManagerOverlay"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Vanilla_RTX_App.Modules.ShaderMods"
                        xmlns:core="using:Vanilla_RTX_App.Core.Overlays"
                        xmlns:overlays="using:Vanilla_RTX_App.Core.Overlays"
                        IsTextScaleFactorEnabled="False">

    <Grid>

        <!-- Loading Screen -->
        <Grid x:Name="LoadingPanel"
              Visibility="Visible"
              Background="Transparent">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="20">
                <ProgressRing IsActive="True"
                              Width="100"
                              Height="100" />

                <!-- What the wait is for. Set from code at each stage - locating the game,
                     asking the preset sources, reading presets off disk - because every one of
                     them can be the slow one depending on the machine and the connection. -->
                <TextBlock x:Name="LoadingStatusText"
                           Text="Getting things ready..."
                           FontSize="14"
                           Opacity="0.85"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           IsTextScaleFactorEnabled="False" />

                <!-- Shown together, and only while a manual pick is the thing being offered: the
                     explanation under the button reads as an instruction for whatever is on screen,
                     so it must never outlive the button it explains. -->
                <StackPanel x:Name="ManualSelectionPanel"
                            Visibility="Collapsed"
                            Spacing="20"
                            HorizontalAlignment="Center">
                    <Button x:Name="ManualSelectionButton"
                            HorizontalAlignment="Center"
                            Padding="20,12,20,12"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="ManualSelectionButton_Click">
                        <StackPanel Spacing="10">
                            <TextBlock Text="We couldn't auto-locate your game files using conventional tactics&#x0a;A system-wide scan is in progress, there is a high chance it will find your game given enough time."
                                       FontSize="14"
                                       TextAlignment="Center"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       IsTextScaleFactorEnabled="False" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ManualSelectionText"
                               Text="Taking far too long? Click above and manually navigate to the folder where the game is installed to, it should have a file called Minecraft.Windows.exe inside of it. You could do the same from the settings menu, but if you're still having trouble finding out where your game is installed to, join the Vanilla RTX Discord server and ask for help, or try to find out online."
                               FontSize="13"
                               Opacity="0.75"
                               FontWeight="Normal"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400"
                               IsTextScaleFactorEnabled="False" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Preset Selection UI - one flat [scrollable, fixed-bar] split. -->
        <Grid x:Name="PresetSelectionPanel"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <!-- No-backup notice (fixed) -->
                <RowDefinition Height="Auto" />
                <!-- Preset list (scrollable) -->
                <RowDefinition Height="*" />
                <!-- Import manually (fixed) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="DefaultMissingCard"
                    Grid.Row="0"
                    Margin="20,12,24,0"
                    Visibility="Collapsed"
                    CornerRadius="6"
                    Padding="6"
                    Translation="0,0,32"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Margin="16,8,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE7BA;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="20"
                              VerticalAlignment="Top"
                              Margin="0,5,0,0"
                              IsHitTestVisible="False"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                    <TextBlock x:Name="DefaultMissingText"
                               Grid.Column="1"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Margin="12,0,0,0"
                               Opacity="0.95"
                               VerticalAlignment="Center"
                               IsTextScaleFactorEnabled="False" />
                </Grid>
            </Border>

            <!-- Shadow receiver sits behind the scroll content -->
            <Grid x:Name="ShadowReceiverGrid"
                  Grid.Row="1" />

            <ScrollViewer x:Name="PresetScrollViewer"
                          Grid.Row="1"
                          IsTextScaleFactorEnabled="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- Wrapped both panels in a single parent StackPanel -->

                <StackPanel>
                    <!-- Per-content horizontal margins leave room for card shadows. Collapse
                         an empty panel so its vertical margin does not add a phantom gap. -->
                    <StackPanel x:Name="ShaderModsInfoPanel"
                                Spacing="10"
                                Margin="20,12,24,0"
                                Visibility="Collapsed" />
                    <!-- Preset list -->
                    <StackPanel x:Name="PresetListContainer"
                                Spacing="12"
                                Margin="20,12,24,0"
                                Padding="0,0,0,12" />
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════
                Import manually | Supervanilla RTX downloads | Customize a BetterRTX preset
            ═══════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Margin="0"
                    CornerRadius="0"
                    BorderThickness="0"
                    Translation="0,1,512"
                    Background="Transparent">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <Grid MinHeight="96"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <!-- Import manually -->
                        <ColumnDefinition Width="1.5*" />
                        <!-- Gap 6 px -->
                        <ColumnDefinition Width="6" />
                        <!-- Supervanilla RTX for older versions -->
                        <ColumnDefinition Width="1*" />
                        <!-- Gap 6 px -->
                        <ColumnDefinition Width="6" />
                        <!-- Customize a BetterRTX preset -->
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── Import manually ──────────────── -->
                    <Button x:Name="AddPresetButton"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="20,0,20,0"
                            CornerRadius="0"
                            BorderThickness="0"
                            IsTextScaleFactorEnabled="False"
                            AllowDrop="True"
                            Click="AddPresetButton_Click"
                            DragOver="AddPresetButton_DragOver"
                            DragEnter="AddPresetButton_DragEnter"
                            DragLeave="AddPresetButton_DragLeave"
                            Drop="AddPresetButton_Drop"
                            ToolTipService.ToolTip="Drag and drop or browse for .rtpack preset files - Supervanilla RTX builds or presets exported from the BetterRTX website, or others">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="96"
                                    Height="96"
                                    CornerRadius="5,0,0,5"
                                    Background="Transparent">
                                <FontIcon Glyph="&#xE710;"
                                          FontSize="44"
                                          FontWeight="ExtraLight"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsTextScaleFactorEnabled="False" />
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Import manually (.rtpack)"
                                           FontWeight="SemiBold"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           IsTextScaleFactorEnabled="False" />
                                <TextBlock Text="Drag and drop or browse for .rtpack files - Supervanilla RTX builds or BetterRTX presets"
                                           FontSize="12"
                                           Opacity="0.75"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           IsTextScaleFactorEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- ── SUPERVANILLA RTX DOWNLOADS ─────────── -->
                    <!-- Built exactly like Customize a BetterRTX preset beside it: a solid backdrop under
                         a HyperlinkButton, whose own background is too translucent on its own. -->
                    <Rectangle Grid.Column="2"
                               Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                               IsHitTestVisible="False" />

                    <!-- The label under the title names the address it opens - see
                         ShaderModManagerOverlay.ShowBrowseTargets. -->
                    <HyperlinkButton x:Name="SupervanillaDownloadsLink"
                                     Grid.Column="2"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Padding="0"
                                     CornerRadius="0"
                                     BorderThickness="0"
                                     IsTextScaleFactorEnabled="False"
                                     Click="SupervanillaDownloadsButton_Click">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="8">
                                <FontIcon Glyph="&#xE81C;"
                                          FontSize="20"
                                          Margin="0,3,0,0"
                                          VerticalAlignment="Center"
                                          IsTextScaleFactorEnabled="False" />
                                <TextBlock Text="Supervanilla RTX for other versions"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsTextScaleFactorEnabled="False" />
                            </StackPanel>
                            <TextBlock x:Name="SupervanillaDownloadsTargetText"
                                       FontSize="11"
                                       Opacity="0.67"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       IsTextScaleFactorEnabled="False" />
                        </StackPanel>
                    </HyperlinkButton>

                    <!-- ── Customize a BetterRTX preset ─────────────── -->
                    <!-- Solid backdrop behind the hyperlink button: HyperlinkButton's own
                         background is too translucent against the window now that it's
                         not sitting on top of the Add button anymore. This mimics a
                         regular button's background while leaving hover/pressed states
                         to the hyperlink itself. -->
                    <Rectangle Grid.Column="4"
                               Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                               IsHitTestVisible="False" />

                    <!-- Both the label and the tooltip name the address this actually opens,
                         which is a setting - see ShaderModManagerOverlay.ShowBrowseTargets. -->
                    <HyperlinkButton x:Name="CreatePresetLink"
                                     Grid.Column="4"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Padding="0"
                                     CornerRadius="0"
                                     BorderThickness="0"
                                     IsTextScaleFactorEnabled="False"
                                     Click="CreatePresetButton_Click">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="8">
                                <FontIcon Glyph="&#xE71B;"
                                          FontSize="20"
                                          Margin="0,3,0,0"
                                          VerticalAlignment="Center"
                                          IsTextScaleFactorEnabled="False" />
                                <TextBlock Text="Customize a BetterRTX preset"
                                           FontWeight="SemiBold"
                                           x:Name="BetterRTXWebsiteButtonText"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsTextScaleFactorEnabled="False" />
                            </StackPanel>
                            <TextBlock x:Name="CreatePresetTargetText"
                                       FontSize="11"
                                       Opacity="0.67"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       IsTextScaleFactorEnabled="False" />
                        </StackPanel>
                    </HyperlinkButton>

                    <!-- ── BEVELLED SPLIT SEAMS ─────────────────── -->
                    <!-- Each seam is the left button's dark edge meeting the right one's bright
                         edge, the same pair everywhere in the app. -->
                    <Grid Grid.Column="0"
                          HorizontalAlignment="Right"
                          Width="3"
                          Margin="0,0,-3,0"
                          IsHitTestVisible="False">
                        <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                        <Border BorderBrush="{ThemeResource FakeSplitButtonDarkBorderColor}"
                                BorderThickness="3,0,0,0" />
                    </Grid>

                    <Grid Grid.Column="2"
                          HorizontalAlignment="Left"
                          Width="3"
                          Margin="-3,0,0,0"
                          IsHitTestVisible="False">
                        <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                        <Border BorderBrush="{ThemeResource FakeSplitButtonBrightBorderColor}"
                                BorderThickness="3,0,0,0" />
                    </Grid>

                    <Grid Grid.Column="2"
                          HorizontalAlignment="Right"
                          Width="3"
                          Margin="0,0,-3,0"
                          IsHitTestVisible="False">
                        <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                        <Border BorderBrush="{ThemeResource FakeSplitButtonDarkBorderColor}"
                                BorderThickness="3,0,0,0" />
                    </Grid>

                    <Grid Grid.Column="4"
                          HorizontalAlignment="Left"
                          Width="3"
                          Margin="-3,0,0,0"
                          IsHitTestVisible="False">
                        <Rectangle Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                        <Border BorderBrush="{ThemeResource FakeSplitButtonBrightBorderColor}"
                                BorderThickness="3,0,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ Titlebar Actions ═══════════════════════════════════════════════
             Declared here so the buttons' x:Name fields and Click handlers belong to this
             class, but it never renders here: ModuleOverlayTitleBar takes the whole Border
             and shows it in MainWindow's titlebar for as long as this module is open, where
             it reads as a continuation of the buttons already there. That control owns the
             placement and the divider in front of it - this is only what goes in it, sized
             the way MainWindow sizes its own. See ModuleOverlay.TitleBarStrip.
             ═══════════════════════════════════════════════════════════════════ -->
        <Border x:Name="TitleBarActions">
            <Grid Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1">
                <Button x:Name="RefreshButton"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="40"
                        Height="35"
                        CornerRadius="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="RefreshButton_Click"
                        IsTextScaleFactorEnabled="False"
                        ToolTipService.ToolTip="Resets the preset cache: clears every downloaded and imported preset and fetches the Supervanilla RTX and BetterRTX lists again. A source that can't be reached is left exactly as it was.
                        &#x0a;&#x0a;Note: This happens automatically whenever Minecraft is updated, and whenever the app notices either source has published something new - hence this button exists for when an update hasn't been picked up yet, such as BetterRTX shipping new files without its list changing.
                        &#x0a;&#x0a;Note 2: This button won't clear your Default RTX preset, which is backed up the first time you open this manager. Only game updates can trigger a reset of Default preset, so ultimately the app can pick up the new defaults fresh from the new update of your game.">
                    <Grid>
                        <FontIcon x:Name="RefreshIcon"
                                  Glyph="&#xE72C;"
                                  FontSize="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsTextScaleFactorEnabled="False" />
                        <TextBlock x:Name="RefreshCountdownText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   IsTextScaleFactorEnabled="False" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <core:WebImportOverlay x:Name="WebImportOverlay" />
    </Grid>
</overlays:ModuleOverlay>
