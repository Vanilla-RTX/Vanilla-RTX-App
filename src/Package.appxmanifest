<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap5 rescap">

  <Identity
    Name="Cubeir.VanillaRTXApp"
    Publisher="CN=7F2D29F8-D1F9-46A7-9DFB-595D98E11214"
    Version="4.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="14d771a9-af30-450d-a688-01bb3e8bc3bc" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Vanilla RTX App</DisplayName>
    <PublisherDisplayName>Cubeir</PublisherDisplayName>
    <Logo>Assets\icons\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Vanilla RTX App"
        Description="The ultimate companion app for playing Minecraft with RTX at its best! Automatically update Vanilla RTX packages, tune them to your preferences, and launch Minecraft with RTX in one go, plus so much more!"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\icons\Square150x150Logo.png"
        Square44x44Logo="Assets\icons\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\icons\Wide310x150Logo.png"  Square71x71Logo="Assets\icons\SmallTile.png" Square310x310Logo="Assets\icons\LargeTile.png" ShortName="Vanilla RTX App">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo"/>
            <uap:ShowOn Tile="wide310x150Logo"/>
            <uap:ShowOn Tile="square310x310Logo"/>
          </uap:ShowNameOnTiles>
        </uap:DefaultTile >
        <uap:SplashScreen Image="Assets\icons\SplashScreen.png"  BackgroundColor="transparent"/>
      </uap:VisualElements>

      <Extensions>
        <!-- File types the app can be opened with. Each one registers the app as an option in
             "Open with" alongside Minecraft's own association - it does not claim the default
             handler; Windows leaves that to the user. What happens next is
             Core\FileActivation\FileActivationRouter.cs, and its Routes table has to agree with
             this list: the manifest is what makes Explorer offer the app, the table is what the
             app does with the file. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="mcpack">
            <uap:SupportedFileTypes>
              <uap:FileType>.mcpack</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Minecraft Resource Pack</uap:DisplayName>
            <uap:Logo>Assets\icons\import.mcpack.png</uap:Logo>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="import">Import into Vanilla RTX App</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="rtpack">
            <uap:SupportedFileTypes>
              <uap:FileType>.rtpack</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Minecraft RTX Shader Pack</uap:DisplayName>
            <uap:Logo>Assets\icons\import.rtpack.png</uap:Logo>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="import">Import into Vanilla RTX App</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- vanillartx://<command> links - what each command opens is
             Core\FileActivation\MainWindow.LinkCommands.cs. A link can only open a screen,
             never act: any web page can put one in front of a user. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="vanillartx">
            <uap:DisplayName>Vanilla RTX App</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Lets "vanillartx" start the app from Win+R or a terminal.
             Executable and EntryPoint are spelled out rather than using the $targetnametoken$ /
             $targetentrypoint$ tokens the Application element uses: the build only substitutes
             those on Application itself, and left here they reach the package literally.
             Executable is the assembly name - rename the project and this has to follow. -->
        <uap5:Extension Category="windows.appExecutionAlias"
                        Executable="Vanilla RTX App.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="vanillartx.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
