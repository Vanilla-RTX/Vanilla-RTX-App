<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Vanilla_RTX_App</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Publish already pins RuntimeIdentifier per win-$(Platform).pubxml, but a plain
         Debug/Release build (VS F5, or `dotnet build`) never resolves $(Platform) to a single
         RuntimeIdentifier on its own. Without one, NuGet's selection of runtimes/{rid}/native*
         assets is ambiguous across the three RuntimeIdentifiers above, and it silently landed on
         win-x86's copy of Microsoft.Web.WebView2.Core.dll even inside the x64 output folder - a
         32-bit native WinRT activation factory loaded from the x64 process, which is exactly
         BadImageFormatException / "not a valid Win32 application" (0x800700C1). Nothing caught
         this earlier because Magick.NET's native libraries self-select by file name at runtime
         instead of relying on NuGet's RID filtering. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'=='' and '$(Platform)'=='x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'=='' and '$(Platform)'=='x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'=='' and '$(Platform)'=='ARM64'">win-arm64</RuntimeIdentifier>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Release publishes trimmed (see PublishTrimmed further down). Without these, code that
         needs runtime reflection compiles clean in Debug and only fails once it's trimmed - in
         front of the user. Running the trim analyzer on every build turns that into a normal
         compile warning here instead. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <!-- Here purely so the repo's LICENSE shows up in Solution Explorer. -->
    <None Include="..\LICENSE.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.17.2" />
    <PackageReference Include="Magick.NET.Core" Version="14.17.2" />
    <PackageReference Include="Magick.NET.SystemDrawing" Version="8.0.28" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Magick.NET-Q16-AnyCPU" />
    <TrimmerRootAssembly Include="Magick.NET.Core" />
    <TrimmerRootAssembly Include="Magick.NET.SystemDrawing" />
    <TrimmerRootAssembly Include="Markdig" />
    <TrimmerRootAssembly Include="Microsoft.Win32.SystemEvents" />
    <TrimmerRootAssembly Include="System.Drawing.Common" />
    <TrimmerRootAssembly Include="System.Text.Json" />
    <TrimmerRootAssembly Include="WinUIEx" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\vrtx.lamp.on.128x.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="Modules\Alchitex\ALCHITEX_LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      Asset folders, wildcarded rather than listed file by file.
    -->
    <Content Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="Modules\Alchitex\Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Modules\LUT\Presets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      MATERIALS.md is private documentation for hand-tuning materials.json
    -->
    <None Update="Modules\Alchitex\Assets\MATERIALS.md">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <Page Update="Core\TeletextCard.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Modules\Alchitex\AlchitexOverlay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Modules\LUT\LUTManagerOverlay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Modules\PackUpdater\PackUpdaterOverlay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Modules\ShaderMods\ShaderModManagerOverlay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Modules\DLSS\DLSSSwapperOverlay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Modules\PackBrowser\PackBrowserOverlay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <WebView2WinRTWrapSystemTypes>False</WebView2WinRTWrapSystemTypes>
  </PropertyGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <VersionPrefix>4.0.0.0</VersionPrefix>  <!-- SET ASSEMBLY VERSION HERE -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    <ApplicationIcon>Assets\vrtx.lamp.on.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Auto</AppxBundle>
    <HoursBetweenUpdateChecks>24</HoursBetweenUpdateChecks>
    <AppxPackageDir>C:\Users\Administrator\Desktop\</AppxPackageDir>
    <PackageCertificateThumbprint>1426D6CA9C80678225E501154069D87676C19DC6</PackageCertificateThumbprint>
    <SignAssembly>False</SignAssembly>
    <Copyright>All Rights Reserved.</Copyright>
    <PackageProjectUrl>https://github.com/vanilla-rtx/Vanilla-RTX-App</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vanilla-rtx/Vanilla-RTX-App</RepositoryUrl>
    <AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>
    <AssemblyName>Vanilla RTX App</AssemblyName>
    <AssemblyOriginatorKeyFile>CubeirSoftware.pfx</AssemblyOriginatorKeyFile>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Was a flat <PlatformTarget>AnyCPU</PlatformTarget> for every $(Platform). That's the
         actual root cause of the WebView2 0x800700C1 crash: Microsoft.Web.WebView2's own
         Common.targets special-cases PlatformTarget=="AnyCPU" for a managed project to mean
         "use the x86 native_uap assets" unconditionally, so every configuration - x64 included -
         was getting handed the 32-bit Microsoft.Web.WebView2.Core.dll, which a 64-bit process
         cannot activate. PlatformTarget now tracks $(Platform) like it should for a project that
         already builds separate per-architecture outputs. -->
    <PlatformTarget Condition="'$(Platform)'=='x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)'=='x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)'=='ARM64'">ARM64</PlatformTarget>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <ErrorReport>none</ErrorReport>
    <Description>The Official Vanilla RTX App</Description>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <PackageTags>Minecraft, RTX, BetterRTX, Supervanilla RTX, Minecraft RTX, Minecraft Preview</PackageTags>
    <PackageIcon>vrtx.lamp.on.128x.png</PackageIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <DebugType>none</DebugType>
    <WarningLevel>1</WarningLevel>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>none</DebugType>
    <WarningLevel>1</WarningLevel>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <DebugType>none</DebugType>
    <WarningLevel>1</WarningLevel>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <DebugType>none</DebugType>
    <WarningLevel>1</WarningLevel>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>none</DebugType>
    <WarningLevel>1</WarningLevel>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <DebugType>none</DebugType>
    <WarningLevel>1</WarningLevel>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
</Project>