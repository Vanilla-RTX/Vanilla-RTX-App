<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Vanilla_RTX_App.Core.Overlays.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Vanilla_RTX_App.Core.Overlays"
             mc:Ignorable="d"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             IsTextScaleFactorEnabled="False">

    <UserControl.Resources>

        <!-- The faint one-liner under a control saying what it is for. Small and low-contrast
             on purpose: there are a lot of them, and at full strength they would out-shout the
             settings they explain. -->
        <Style x:Key="SettingsHintTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>

        <!-- A hint saying why an address, or a picked folder, was rejected. A style rather than a
             colour set from code, because a brush looked up in code resolves against Windows'
             theme rather than the app's and never follows a change to either - so it was the
             one hint in the panel still drawn in dark-theme colours on the light theme. -->
        <Style x:Key="SettingsHintRejectedTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SettingsHintTextStyle}">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>

        <!-- The label that opens a section. -->
        <Style x:Key="SettingsSectionHeaderStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>

        <!-- The name above a single setting, inside a section. -->
        <Style x:Key="SettingsItemLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>

        <!-- The horizontal rule between sections. Extra margin above and below because the
             panel's own StackPanel spacing is tuned for controls sitting next to each other,
             not for a break between subjects. -->
        <Style x:Key="SettingsSeparatorStyle"
               TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!-- Left half of a path selector, and a real Button rather than a Border: clicking it
             opens the folder in File Explorer, so it has to take focus and show hover and
             pressed states like any other control that does something.

             It is the stock button style with nothing but a corner radius and an alignment
             changed. An earlier version overrode BorderThickness to drop the right edge, which
             fights the default template: that border is a two-tone elevation brush and the
             template swaps it for a flat one on press, so the row visibly changed shape under
             the pointer and came apart from the accent button glued to it. -->
        <Style x:Key="SettingsPathBoxStyle"
               TargetType="Button">
            <Setter Property="CornerRadius" Value="4,0,0,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>

        <Style x:Key="SettingsPathTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>

        <Style x:Key="SettingsPathButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="0,4,4,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>

        <!-- A full-width accent action, its label centred on the button. -->
        <Style x:Key="SettingsActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>

        <!-- Wraps rather than scrolling sideways: these hold long raw.githubusercontent paths,
             and a single line shows the user the middle of their own URL with both ends hidden.
             AcceptsReturn stays false - the row grows to fit, but Enter still means "commit". -->
        <Style x:Key="SettingsUrlBoxStyle"
               TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>

        <Style x:Key="SettingsUrlResetButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="8,6,8,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
            <Setter Property="ToolTipService.ToolTip" Value="Put the built-in address back." />
        </Style>

    </UserControl.Resources>

    <!-- Sibling of MarkdownOverlay - same 36px top inset, so it starts flush under the
         titlebar's bevelled edge and reads as the window's body being replaced rather than as
         a panel dropped on top of the whole app. Unlike that one it only claims the left half:
         everything in here is a setting about the app, and the tuning surface staying visible
         behind it is what keeps that legible.

         The two columns ARE the split. The blocker spans both and sits behind the panel, so a
         click anywhere the panel isn't - including the strip underneath it, which the panel's
         own background absorbs first - dismisses.

         They are two layers rather than one surface, and that is what lets them move
         differently: the scrim only ever fades, while the panel fades and slides in over its
         own width. The right half of the panel's layer is nothing at all - no element, so no
         hit testing and nothing to dim - which is why the two read as one surface at rest.
         The opacities start at 0 here rather than on the UserControl, because the root's job
         is now only to be Collapsed and unreachable between opens. -->
    <Grid x:Name="Root"
          Margin="0,36,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Click-to-dismiss scrim. Tapped rather than a Button so it stays a surface with no
             focus, no keyboard reachability and no press visuals - it is the absence of the
             panel, not a control. -->
        <Border x:Name="ModalBlocker"
                Grid.ColumnSpan="2"
                Background="#66000000"
                Opacity="0"
                Tapped="ModalBlocker_Tapped" />

        <Border x:Name="PanelSurface"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Opacity="0"
                Translation="0,0,64">
            <!-- A RenderTransform rather than the composition Translation this Border
                 already carries: that property is spoken for by the Z offset the ThemeShadow
                 below needs, and the two compose without either having to know about the
                 other. -->
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelSlide" />
            </Border.RenderTransform>
            <Border.Background>
                <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                              TintOpacity="0.9"
                              TintLuminosityOpacity="0.9"
                              FallbackColor="{ThemeResource AcrylicFallbackColor}" />
            </Border.Background>
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="18,0,30,0">
                    <StackPanel Spacing="14"
                                Tapped="PanelBody_Tapped">

                        <!-- ═══ Appearance ═══════════════════════════════════════════════
                             Shares its row with the close button, which is deliberately part
                             of the scrolling content rather than pinned over it -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Appearance"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SettingsSectionHeaderStyle}" />

                            <!-- Back-to-window rather than a Cancel cross: this panel replaces
                                 the window's body and leaving it returns you to what was there,
                                 where a cross says the thing you were doing is being discarded.
                                 A FontIcon for the same reason - SymbolIcon only reaches the
                                 Segoe MDL2 subset, and this glyph isn't in it. No background,
                                 because at this size a filled button out-weighs the section
                                 headings it sits level with. -->
                            <Button x:Name="CloseButton"
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="CloseButton_Click"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Return to main menu.">
                                <FontIcon Glyph="&#xE944;" FontSize="16"/>
                            </Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="App theme"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,10,0"
                                       IsTextScaleFactorEnabled="False" />

                            <!-- DropDownButton + MenuFlyout -->
                            <Border Grid.Column="1"
                                    CornerRadius="4"
                                    Translation="0,0,12">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <DropDownButton x:Name="ThemeModeButton"
                                                MinWidth="132"
                                                HorizontalContentAlignment="Left"
                                                IsTextScaleFactorEnabled="False">
                                    <DropDownButton.Content>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <FontIcon x:Name="ThemeModeGlyph"
                                                      Glyph="&#xEC46;"
                                                      FontSize="15"
                                                      VerticalAlignment="Center" />
                                            <TextBlock x:Name="ThemeModeLabel"
                                                       Text="Dark"
                                                       VerticalAlignment="Center"
                                                       IsTextScaleFactorEnabled="False" />
                                        </StackPanel>
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <RadioMenuFlyoutItem x:Name="ThemeSystemItem"
                                                                 Text="Auto"
                                                                 GroupName="AppThemeMode"
                                                                 Click="ThemeModeItem_Click"
                                                                 Tag="System" />
                                            <RadioMenuFlyoutItem x:Name="ThemeLightItem"
                                                                 Text="Light"
                                                                 GroupName="AppThemeMode"
                                                                 Click="ThemeModeItem_Click"
                                                                 Tag="Light" />
                                            <RadioMenuFlyoutItem x:Name="ThemeDarkItem"
                                                                 Text="Dark"
                                                                 GroupName="AppThemeMode"
                                                                 Click="ThemeModeItem_Click"
                                                                 Tag="Dark" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Disable UI Visual Effects"
                                           TextWrapping="Wrap"
                                           IsTextScaleFactorEnabled="False" />
                                <TextBlock Text="Reduced animations and unique effects throughout the app."
                                           Style="{StaticResource SettingsHintTextStyle}" />
                            </StackPanel>

                            <ToggleSwitch x:Name="SuspendAnimationsSwitch"
                                          Grid.Column="1"
                                          OnContent="On"
                                          OffContent="Off"
                                          VerticalAlignment="Center"
                                          MinWidth="0"
                                          Toggled="SuspendAnimationsSwitch_Toggled"
                                          IsTextScaleFactorEnabled="False" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparatorStyle}" />

                        <!-- ═══ Game installations ═══════════════════════════════════════
                            Split from user data below on purpose. They are found by two
                            independent systems, they live nowhere near each other on disk, and
                            they answer different questions - this is the game's own shipped
                            files, that is everything the game wrote after you played it. Four
                            paths under one heading made "Release vs Preview" the only visible
                            distinction, which is the less important of the two. -->
                        <TextBlock Text="Game installations"
                                   Style="{StaticResource SettingsSectionHeaderStyle}" />

                        <TextBlock Text="Where Minecraft itself is installed. The RTX LUT manager, shader mod manager and DLSS swapper write into these folders. The app may have found the default locations automatically.
                                   &#x0a;The app automatically verifies the path you select and rejects it if it is not a real Minecraft installation directory. Only change if you know what you're doing."
                                   Style="{StaticResource SettingsHintTextStyle}" />

                        <!-- The rows are spelled out rather than generated so they stay editable
                            in XAML hot reload; the wiring that fills and drives them is
                            table-driven in code-behind. -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Minecraft (Release)"
                                       Style="{StaticResource SettingsItemLabelStyle}" />
                            <Grid CornerRadius="6,4,4,6"
                                  Translation="0,0,32">
                                <Grid.Shadow>
                                    <ThemeShadow />
                                </Grid.Shadow>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ReleaseInstallPathButton"
                                        Grid.Column="0"
                                        MinHeight="32"
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="6,0,0,6"
                                        HorizontalAlignment="Stretch"
                                        Click="ReleaseInstallPathButton_Click">
                                    <TextBlock x:Name="ReleaseInstallPathText"
                                               Style="{StaticResource SettingsPathTextStyle}" />
                                </Button>
                                <Rectangle Grid.Column="1"
                                           Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                                <Border x:Name="ReleaseInstallBevel"
                                        Grid.Column="1"
                                        BorderThickness="3,0,0,0" />
                                <Button x:Name="ReleaseInstallButton"
                                        Grid.Column="2"
                                        Style="{StaticResource SettingsPathButtonStyle}"
                                        Click="ReleaseInstallButton_Click"
                                        Content="Select" />
                            </Grid>
                            <TextBlock x:Name="ReleaseInstallHint"
                                       Style="{StaticResource SettingsHintTextStyle}"
                                       Text="Pick the folder holding Minecraft.Windows.exe, or the &quot;Minecraft for Windows&quot; folder one level above it." />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Minecraft Preview"
                                       Style="{StaticResource SettingsItemLabelStyle}" />
                            <Grid CornerRadius="6,4,4,6"
                                  Translation="0,0,32">
                                <Grid.Shadow>
                                    <ThemeShadow />
                                </Grid.Shadow>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PreviewInstallPathButton"
                                        Grid.Column="0"
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        BorderBrush="Transparent"
                                        MinHeight="32"
                                        BorderThickness="0"
                                        CornerRadius="6,0,0,6"
                                        HorizontalAlignment="Stretch"
                                        Click="PreviewInstallPathButton_Click">
                                    <TextBlock x:Name="PreviewInstallPathText"
                                               Style="{StaticResource SettingsPathTextStyle}" />
                                </Button>
                                <Rectangle Grid.Column="1"
                                           Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                                <Border x:Name="PreviewInstallBevel"
                                        Grid.Column="1"
                                        BorderThickness="3,0,0,0" />
                                <Button x:Name="PreviewInstallButton"
                                        Grid.Column="2"
                                        Style="{StaticResource SettingsPathButtonStyle}"
                                        Click="PreviewInstallButton_Click"
                                        Content="Select" />
                            </Grid>
                            <TextBlock x:Name="PreviewInstallHint"
                                       Style="{StaticResource SettingsHintTextStyle}"
                                       Text="Same, under &quot;Minecraft Preview for Windows&quot;. The app reads the game's own config file and makes sure it isn't the regular Release version by mistake." />
                        </StackPanel>

                        <Border Style="{StaticResource SettingsSeparatorStyle}" />

                        <!-- ═══ Game user data ═══════════════════════════════════════════ -->
                        <TextBlock Text="Game user data"
                                   Style="{StaticResource SettingsSectionHeaderStyle}" />

                        <TextBlock Text="Where the game keeps your worlds, settings and resource packs. Pack selection, tuning, importing, exporting and the Launch button all need this one, and it only exists once you've played the game at least once."
                                   Style="{StaticResource SettingsHintTextStyle}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Minecraft User Data (Release)"
                                       Style="{StaticResource SettingsItemLabelStyle}" />
                            <Grid CornerRadius="6,4,4,6"
                                  Translation="0,0,32">
                                <Grid.Shadow>
                                    <ThemeShadow />
                                </Grid.Shadow>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ReleaseDataPathButton"
                                        Grid.Column="0"
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        MinHeight="32"
                                        CornerRadius="6,0,0,6"
                                        HorizontalAlignment="Stretch"
                                        Click="ReleaseDataPathButton_Click">
                                    <TextBlock x:Name="ReleaseDataPathText"
                                               Style="{StaticResource SettingsPathTextStyle}" />
                                </Button>
                                <Rectangle Grid.Column="1"
                                           Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                                <Border x:Name="ReleaseDataBevel"
                                        Grid.Column="1"
                                        BorderThickness="3,0,0,0" />
                                <Button x:Name="ReleaseDataButton"
                                        Grid.Column="2"
                                        Style="{StaticResource SettingsPathButtonStyle}"
                                        Click="ReleaseDataButton_Click"
                                        Content="Select" />
                            </Grid>
                            <TextBlock x:Name="ReleaseDataHint"
                                       Style="{StaticResource SettingsHintTextStyle}"
                                       Text="Pick the folder named &quot;Minecraft Bedrock&quot; - the one with a &quot;Users&quot; subfolder inside it. Usually under %appdata%." />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Minecraft User Data Preview"
                                       Style="{StaticResource SettingsItemLabelStyle}" />
                            <Grid CornerRadius="6,4,4,6"
                                  Translation="0,0,32">
                                <Grid.Shadow>
                                    <ThemeShadow />
                                </Grid.Shadow>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PreviewDataPathButton"
                                        Grid.Column="0"
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        MinHeight="32"
                                        CornerRadius="6,0,0,6"
                                        HorizontalAlignment="Stretch"
                                        Click="PreviewDataPathButton_Click">
                                    <TextBlock x:Name="PreviewDataPathText"
                                               Style="{StaticResource SettingsPathTextStyle}" />
                                </Button>
                                <Rectangle Grid.Column="1"
                                           Fill="{ThemeResource ButtonBackgroundThemeBrush}" />
                                <Border x:Name="PreviewDataBevel"
                                        Grid.Column="1"
                                        BorderThickness="3,0,0,0" />
                                <Button x:Name="PreviewDataButton"
                                        Grid.Column="2"
                                        Style="{StaticResource SettingsPathButtonStyle}"
                                        Click="PreviewDataButton_Click"
                                        Content="Select" />
                            </Grid>
                            <TextBlock x:Name="PreviewDataHint"
                                       Style="{StaticResource SettingsHintTextStyle}"
                                       Text="Same, but named &quot;Minecraft Bedrock Preview&quot; instead." />
                        </StackPanel>

                        <Border Style="{StaticResource SettingsSeparatorStyle}" />

                        <!-- ═══ Launch options ═══════════════════════════════════════════ -->
                        <TextBlock Text="Launch options"
                                   Style="{StaticResource SettingsSectionHeaderStyle}" />

                        <TextBlock Text="Settings written into every account's options.txt just before the `Launch Minecraft RTX` button or vanillartx:// protocols start the game. The defaults turn ray tracing on, allow switching graphics modes in-game, and disable VSync."
                                   Style="{StaticResource SettingsHintTextStyle}" />

                        <!-- Rows are built in code - there is no fixed number of them. -->
                        <StackPanel x:Name="LaunchOptionRows"
                                    Spacing="6" />

                        <TextBlock x:Name="LaunchOptionsEmptyText"
                                   Visibility="Collapsed"
                                   Style="{StaticResource SettingsHintTextStyle}"
                                   Text="No options - the Launch button will start the game without touching any game setting." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddLaunchOptionButton"
                                    Translation="0,0,12"
                                    Grid.Column="0"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="AddLaunchOptionButton_Click"
                                    IsTextScaleFactorEnabled="False"
                                    ToolTipService.ToolTip="Add another options.txt setting to write before launching.">
                                <Button.Shadow>
                                    <ThemeShadow />
                                </Button.Shadow>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE710;"
                                              FontSize="14"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Add option"
                                               VerticalAlignment="Center"
                                               IsTextScaleFactorEnabled="False" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResetLaunchOptionsButton"
                                    Grid.Column="2"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Click="ResetLaunchOptionsButton_Click"
                                    IsTextScaleFactorEnabled="False"
                                    ToolTipService.ToolTip="Put the three default options back.">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE777;"
                                              FontSize="14"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Defaults"
                                               VerticalAlignment="Center"
                                               IsTextScaleFactorEnabled="False" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparatorStyle}" />

                        <!-- ═══ Content sources ══════════════════════════════════════════
                            Every address the app goes to for something it doesn't ship. Each
                            row is a box, a revert-to-built-in button, and a line that doubles
                            as the rejection message - see the code-behind's UrlField. The
                            built-in address always comes back on its own if what is stored
                            ever stops validating, which is what makes these safe to expose. -->
                        <TextBlock Text="Content sources"
                                   Style="{StaticResource SettingsSectionHeaderStyle}" />

                        <TextBlock Text="Where the app gets some of the things it doesn't ship by itself. Change one and that feature goes to your address instead."
                                   Style="{StaticResource SettingsHintTextStyle}" />

                        <TextBlock Text="Documentation page"
                                   Style="{StaticResource SettingsItemLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DocumentationBox"
                                     Translation="0,0,24"
                                     Grid.Column="0"
                                     Margin="0,0,6,0"
                                     Style="{StaticResource SettingsUrlBoxStyle}">
                                <TextBox.Shadow>
                                    <ThemeShadow />
                                </TextBox.Shadow>
                            </TextBox>
                            <Button x:Name="DocumentationResetButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingsUrlResetButtonStyle}">
                                <FontIcon Glyph="&#xE777;"
                                          FontSize="13" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="DocumentationHint"
                                   Margin="0,-10,0,0"
                                   Style="{StaticResource SettingsHintTextStyle}" />

                        <TextBlock Text="Minecraft RTX bug list"
                                   Style="{StaticResource SettingsItemLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BugTrackerBox"
                                     Translation="0,0,24"
                                     Grid.Column="0"
                                     Margin="0,0,6,0"
                                     Style="{StaticResource SettingsUrlBoxStyle}">
                                <TextBox.Shadow>
                                    <ThemeShadow />
                                </TextBox.Shadow>
                            </TextBox>
                            <Button x:Name="BugTrackerResetButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingsUrlResetButtonStyle}">
                                <FontIcon Glyph="&#xE777;"
                                          FontSize="13" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="BugTrackerHint"
                                   Margin="0,-10,0,0"
                                   Style="{StaticResource SettingsHintTextStyle}" />

                        <TextBlock Text="DLSS downloads"
                                   Style="{StaticResource SettingsItemLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DlssProviderBox"
                                     Translation="0,0,24"
                                     Grid.Column="0"
                                     Margin="0,0,6,0"
                                     Style="{StaticResource SettingsUrlBoxStyle}">
                                <TextBox.Shadow>
                                    <ThemeShadow />
                                </TextBox.Shadow>
                            </TextBox>
                            <Button x:Name="DlssProviderResetButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingsUrlResetButtonStyle}">
                                <FontIcon Glyph="&#xE777;"
                                          FontSize="13" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="DlssProviderHint"
                                   Margin="0,-10,0,0"
                                   Style="{StaticResource SettingsHintTextStyle}" />

                        <TextBlock Text="BetterRTX preset creator"
                                   Style="{StaticResource SettingsItemLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BetterRtxCreatorBox"
                                     Translation="0,0,24"
                                     Grid.Column="0"
                                     Margin="0,0,6,0"
                                     Style="{StaticResource SettingsUrlBoxStyle}">
                                <TextBox.Shadow>
                                    <ThemeShadow />
                                </TextBox.Shadow>
                            </TextBox>
                            <Button x:Name="BetterRtxCreatorResetButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingsUrlResetButtonStyle}">
                                <FontIcon Glyph="&#xE777;"
                                          FontSize="13" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="BetterRtxCreatorHint"
                                   Margin="0,-10,0,0"
                                   Style="{StaticResource SettingsHintTextStyle}" />

                        <Border Style="{StaticResource SettingsSeparatorStyle}" />

                        <!-- ═══ Maintenance ══════════════════════════════════════════════ -->
                        <TextBlock Text="Maintenance"
                                   Style="{StaticResource SettingsSectionHeaderStyle}" />

                        <StackPanel Spacing="5">
                            <Button x:Name="HardResetButton"
                                    Translation="0,0,32"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                                    Click="HardResetButton_Click">
                                <Button.Shadow>
                                    <ThemeShadow />
                                </Button.Shadow>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <FontIcon Glyph="&#xE7BA;"
                                              FontSize="16"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Wipe all app data"
                                               VerticalAlignment="Center"
                                               IsTextScaleFactorEnabled="False" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource SettingsHintTextStyle}"
                                       Text="Deletes everything the app has stored on this device, leaving it as if freshly installed. You may be asked to approve several admin prompts so your game's Default RTX and LUT files can be restored before the app's copies of them are gone." />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <Button x:Name="CopyLogsButton"
                                    Translation="0,0,32"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Click="CopyLogsButton_Click">
                                <Button.Shadow>
                                    <ThemeShadow />
                                </Button.Shadow>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <FontIcon Glyph="&#xE8C8;"
                                              FontSize="16"
                                              VerticalAlignment="Center" />
                                    <TextBlock x:Name="CopyLogsButtonText"
                                               Text="Copy debug logs"
                                               VerticalAlignment="Center"
                                               IsTextScaleFactorEnabled="False" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource SettingsHintTextStyle}"
                                       Text="Copies a full diagnostic report to your clipboard - system info, the app's log, every setting and the state of every control. Paste it into a bug report." />
                        </StackPanel>

                        <Border Style="{StaticResource SettingsSeparatorStyle}" />

                        <!-- ═══ Links and credits ════════════════════════════════════════ -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="4"
                                    Margin="0,2,0,0">
                            
                            <HyperlinkButton x:Name="GitHubLink"
                                             Content="GitHub"
                                             Padding="6,2,6,2"
                                             FontWeight="Medium"
                                             Click="GitHubLink_Click"
                                             IsTextScaleFactorEnabled="False"
                                             ToolTipService.ToolTip="Source code, releases and issue tracker." />
                            <TextBlock Text="•"
                                       Opacity="0.5"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False" />
                            <HyperlinkButton x:Name="KoFiLink"
                                             Content="Support the developer (Ko-Fi)"
                                             Padding="6,2,6,2"
                                             FontWeight="Medium"
                                             Click="KoFiLink_Click"
                                             IsTextScaleFactorEnabled="False"
                                             ToolTipService.ToolTip="Buy the developer some coffee - Vanilla RTX is free and continued, help keep it that way!" />
                            <TextBlock Text="•"
                                       Opacity="0.5"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False" />
                            <HyperlinkButton x:Name="DiscordLink"
                                             Content="Discord"
                                             FontWeight="Medium"
                                             Padding="6,2,6,2"
                                             Click="DiscordLink_Click"
                                             IsTextScaleFactorEnabled="False"
                                             ToolTipService.ToolTip="An invitation to the Vanilla RTX Discord server." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="4"
                                    Margin="0,-10,0,0">

                            <HyperlinkButton x:Name="WebsiteLink"
                                             Content="Official Website"
                                             Padding="6,2,6,2"
                                             FontWeight="Medium"
                                             Click="WebsiteLink_Click"
                                             IsTextScaleFactorEnabled="False"
                                             ToolTipService.ToolTip="vanillartx.net, in your browser." />
                            <TextBlock Text="•"
                                       Opacity="0.5"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False" />
                            <HyperlinkButton x:Name="ChessLink"
                                             Content="Try Vanilla RTX Chess"
                                             Padding="6,2,6,2"
                                             FontWeight="Medium"
                                             Click="ChessLink_Click"
                                             IsTextScaleFactorEnabled="False"
                                             ToolTipService.ToolTip="Ray-traced voxel chess, right here in the app." />
                        </StackPanel>

                        <TextBlock x:Name="CreditsText"
                                   Text="With ❤️‍🔥 – By Cubeir (R. Sol)"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.75"
                                   LineHeight="20"
                                   Margin="0,0,0,0"
                                   IsTextScaleFactorEnabled="False" />

                        <TextBlock x:Name="VersionText"
                                   Text="App Version Unknown"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="18"
                                   FontSize="12"
                                   Opacity="0.55"
                                   Margin="0,0,0,7"
                                   IsTextScaleFactorEnabled="False" />

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</UserControl>
