<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Vanilla_RTX_App.Core.Overlays.MarkdownOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Vanilla_RTX_App.Core.Overlays"
             mc:Ignorable="d"
             Visibility="Collapsed"
             Opacity="0"
             IsHitTestVisible="False"
             IsTextScaleFactorEnabled="False">

    <!-- Sibling of WebImportOverlay - same edge-to-edge-below-the-titlebar placement, same
         OverlayHeaderBar chrome, but for GitHub markdown instead of a live page: fetches the
         raw .md text (never HTML, never a WebView2), renders it into plain WinUI elements via
         MarkdownRenderer, and never hands anything back to the caller - there is nothing to
         import from a document. Background is a AcrylicBrush rather than WebImportOverlay's
         opaque one: that control has to hide a live WebView2 sitting behind Loading/Error, this
         one only ever has static content behind it, so translucency costs nothing and matches
         every other in-app overlay (AlchitexOverlay, PackUpdaterOverlay) -->
    <Border x:Name="Panel"
            Margin="0,36,0,0"
            HorizontalAlignment="Stretch"
            Translation="0,0,64">
        <Border.Background>
            <AcrylicBrush TintColor="{ThemeResource OverlayBackgroundColor}"
                          TintOpacity="0.9"
                          TintLuminosityOpacity="0.9"
                          FallbackColor="{ThemeResource AcrylicFallbackColor}" />
        </Border.Background>
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <Border.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        </Border.KeyboardAccelerators>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:OverlayHeaderBar x:Name="Header"
                                     Grid.Row="0">
                <!-- Search, in the header rather than over the page, so it never covers a line
                     of the document. Only ever visible over rendered content (see
                     ShowContent/ShowLoading/ShowError). The toggle and the bar swap places in the
                     same slot rather than one disabling the other, so there is never a dead
                     button sitting there while the bar is open. -->
                <local:OverlayHeaderBar.Actions>
                    <Grid>
                        <Button x:Name="SearchToggleButton"
                                Visibility="Collapsed"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="SearchToggleButton_Click"
                                ToolTipService.ToolTip="Search this page (Ctrl+F)">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                        </Button>

                        <Border x:Name="SearchBar"
                                Visibility="Collapsed"
                                Background="{ThemeResource SolidBackgroundFillColorBase}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="10,4,4,4">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="2">
                                <FontIcon Glyph="&#xE721;"
                                          FontSize="13"
                                          Opacity="0.55"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                <TextBox x:Name="SearchBox"
                                         Width="180"
                                         PlaceholderText="Search this page"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         TextChanged="SearchBox_TextChanged"
                                         KeyDown="SearchBox_KeyDown" />
                                <TextBlock x:Name="SearchMatchCountText"
                                           Text=""
                                           Opacity="0.6"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="6,0,4,0"
                                           MinWidth="46"
                                           IsTextScaleFactorEnabled="False" />
                                <Button x:Name="SearchPreviousButton"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Click="SearchPreviousButton_Click"
                                        ToolTipService.ToolTip="Previous match (Shift+Enter)">
                                    <FontIcon Glyph="&#xE70E;" FontSize="11" />
                                </Button>
                                <Button x:Name="SearchNextButton"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Click="SearchNextButton_Click"
                                        ToolTipService.ToolTip="Next match (Enter)">
                                    <FontIcon Glyph="&#xE70D;" FontSize="11" />
                                </Button>
                                <Button x:Name="SearchCloseButton"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Margin="4,0,0,0"
                                        Click="SearchCloseButton_Click"
                                        ToolTipService.ToolTip="Close search (Esc)">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </local:OverlayHeaderBar.Actions>
            </local:OverlayHeaderBar>

            <Grid x:Name="ContentArea"
                  Grid.Row="1"
                  SizeChanged="ContentArea_SizeChanged">
                <ScrollViewer x:Name="ContentScrollViewer"
                              Visibility="Collapsed"
                              Padding="32,0,32,0"
                              HorizontalAlignment="Center"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="MarkdownHost"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,16,0,0"
                                    MaxWidth="1280"
                                    HorizontalAlignment="Left" />
                </ScrollViewer>

                <Grid x:Name="LoadingState">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <ProgressRing IsActive="True"
                                      Width="36"
                                      Height="36"
                                      HorizontalAlignment="Center" />
                        <TextBlock x:Name="LoadingText"
                                   Text="Loading..."
                                   Opacity="0.75"
                                   HorizontalAlignment="Center"
                                   IsTextScaleFactorEnabled="False" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ErrorState"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Spacing="12">
                        <FontIcon x:Name="ErrorIcon"
                                  Glyph="&#xEB5E;"
                                  FontSize="28"
                                  Opacity="0.7"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorText"
                                   Text="An internet connection is required to load this page."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Opacity="0.85"
                                   IsTextScaleFactorEnabled="False" />
                        <Button Content="Try Again"
                                HorizontalAlignment="Center"
                                Click="RetryButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
